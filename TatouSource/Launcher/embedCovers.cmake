# Turns the cover pictures (assets/covers/aitd1.jpg...) into C++ byte arrays
# compiled into Launcher.exe, so they cannot be swapped from outside.
# Run at build time: cmake -DSOURCE_DIR=... -DOUTPUT=... -P embedCovers.cmake

set(GAMES aitd1 aitd2 aitd3)
set(CONTENT "// Generated by embedCovers.cmake from assets/covers - do not edit\n")
string(APPEND CONTENT "#include <cstddef>\n\n")

foreach(GAME ${GAMES})
    set(FILE "${SOURCE_DIR}/assets/covers/${GAME}.jpg")
    if(NOT EXISTS "${FILE}")
        message(FATAL_ERROR "Missing cover: ${FILE}")
    endif()
    file(READ "${FILE}" HEX HEX)
    string(LENGTH "${HEX}" HEX_LENGTH)
    math(EXPR SIZE "${HEX_LENGTH} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(APPEND CONTENT "extern const unsigned char kCover_${GAME}[] = {${BYTES}};\n")
    string(APPEND CONTENT "extern const size_t kCover_${GAME}_size = ${SIZE};\n\n")
endforeach()

# Only rewrite when the content changes (avoids recompiling every build)
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD)
endif()
if(NOT "${OLD}" STREQUAL "${CONTENT}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
