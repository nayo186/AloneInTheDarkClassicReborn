# Turns the visual fixes of 3D objects (assets/objectFixes/aitd1.cfg and
# jack.cfg, saved by the object editor) into C++ strings compiled into
# Tatou.exe, so every player gets them.
# Run at build time: cmake -DSOURCE_DIR=... -DOUTPUT=... -P embedObjectFixes.cmake

set(GAMES aitd1 jack)
set(CONTENT "// Generated by embedObjectFixes.cmake from assets/objectFixes - do not edit\n\n")

foreach(GAME ${GAMES})
    set(FILE "${SOURCE_DIR}/assets/objectFixes/${GAME}.cfg")
    set(BYTES "")
    if(EXISTS "${FILE}")
        file(READ "${FILE}" HEX HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    endif()
    string(APPEND CONTENT "static const unsigned char kText_${GAME}[] = {${BYTES}0x00};\n")
    string(APPEND CONTENT "extern const char* const kObjectFixes_${GAME} = (const char*)kText_${GAME};\n\n")
endforeach()

# Only rewrite when the content changes (avoids recompiling every build)
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD)
endif()
if(NOT "${OLD}" STREQUAL "${CONTENT}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
