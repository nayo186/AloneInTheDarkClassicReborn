# Turns one picture of Shared/assets into a C++ byte array compiled into a
# program (Time Gate's controller drawing, Shared/ui/controllerPicture.h).
# Run at build time: cmake -DFILE=<picture> -DNAME=<array name> -DOUTPUT=... -P embedPicture.cmake

if(NOT EXISTS "${FILE}")
    message(FATAL_ERROR "Missing picture: ${FILE}")
endif()
file(READ "${FILE}" HEX HEX)
string(LENGTH "${HEX}" HEX_LENGTH)
math(EXPR SIZE "${HEX_LENGTH} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
set(CONTENT "// Generated by embedPicture.cmake from Shared/assets - do not edit\n")
string(APPEND CONTENT "#include <cstddef>\n\n")
string(APPEND CONTENT "extern const unsigned char ${NAME}[] = {${BYTES}};\n")
string(APPEND CONTENT "extern const size_t ${NAME}_size = ${SIZE};\n")

# Only rewrite when the content changes (avoids recompiling every build)
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD)
endif()
if(NOT "${OLD}" STREQUAL "${CONTENT}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
