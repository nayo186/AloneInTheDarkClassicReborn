# Turns the menus' own font (assets/fonts/Gelasio-*.ttf) into C++ byte arrays
# compiled into Launcher and Tatou (Shared/ui/menuFontData.h).
# Run at build time: cmake -DSOURCE_DIR=<Shared> -DOUTPUT=... -P embedFonts.cmake

set(STYLES regular Regular bold Bold)
set(CONTENT "// Generated by embedFonts.cmake from Shared/assets/fonts - do not edit\n")
string(APPEND CONTENT "#include <cstddef>\n\n")

list(LENGTH STYLES COUNT)
math(EXPR LAST "${COUNT} - 1")
foreach(INDEX RANGE 0 ${LAST} 2)
    math(EXPR NAME_INDEX "${INDEX} + 1")
    list(GET STYLES ${INDEX} STYLE)
    list(GET STYLES ${NAME_INDEX} FILE_STYLE)
    set(FILE "${SOURCE_DIR}/assets/fonts/Gelasio-${FILE_STYLE}.ttf")
    if(NOT EXISTS "${FILE}")
        message(FATAL_ERROR "Missing font: ${FILE}")
    endif()
    file(READ "${FILE}" HEX HEX)
    string(LENGTH "${HEX}" HEX_LENGTH)
    math(EXPR SIZE "${HEX_LENGTH} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(APPEND CONTENT "extern const unsigned char kMenuFont_${STYLE}[] = {${BYTES}};\n")
    string(APPEND CONTENT "extern const size_t kMenuFont_${STYLE}_size = ${SIZE};\n\n")
endforeach()

# Only rewrite when the content changes (avoids recompiling every build)
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD)
endif()
if(NOT "${OLD}" STREQUAL "${CONTENT}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
